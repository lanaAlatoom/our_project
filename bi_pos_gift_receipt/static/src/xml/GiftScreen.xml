<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="GiftScreen" owl="1">
        <div class="receipt-screen screen">
            <div class="screen-content">
                <div class="top-content">
                    <div class="top-content-center">
                        <h1>Gift Receipt</h1>
                    </div>
                    <span class="button next highlight" t-on-click="back">
                        <span>New Order</span>
                        <span> </span>
                        <i class="fa fa-angle-double-right"/>
                    </span>
                </div>
                <div class="centered-content">
                    <div class="button print" t-on-click="printReceipt">
                        <i class="fa fa-print"/>
                        <span> </span>
                        <span>Print</span>
                    </div>
                    <div class="pos-receipt-container" t-ref="order-receipt">
                        <t t-if="env.pos.config.enable_gift_receipt">
                            <t t-if="props.confirm_split_data">
                                <t t-foreach="props.split_data.data_list" t-as="list_data" t-key="list_data_index">
                                    <t t-foreach="list_data" t-as="gayu" t-key="gayu_index">
                                        <GiftReceipt RecordLine="props.receiptLineData" product_data="list_data[gayu]"
                                            confirmation="props.confirm_split_data" orderlines="props.orderlines"
                                                barcode="props.barcode"/>
                                    </t>
                                </t>
                            </t>
                            <t t-else="">
                                <GiftReceipt RecordLine="props.receiptLineData"/>
                            </t>
                        </t>
                        <t t-else="">
                            <GiftReceipt RecordLine="props.receiptLineData"/>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
