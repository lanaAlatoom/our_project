<odoo>
    <record id="view_logistic_providers_tree" model="ir.ui.view">
        <field name="name">logistic.providers.tree</field>
        <field name="model">logistic.providers</field>
        <field name="arch" type="xml">
            <tree string="Logistic Providers" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="contact"/>
                <field name="phone"/>
                <field name="service_type"/>
                <field name="lead_time"/>
                <field name="shipping_cost"/>
            </tree>
        </field>
    </record>



    <record id="action_logistic_providers" model="ir.actions.act_window">
        <field name="name">Logistic Providers</field>
        <field name="res_model">logistic.providers</field>
        <field name="view_mode">tree</field>
    </record>


        <menuitem id="purchase_logistic_providers_menu" name="Logistic Providers" parent="purchase.menu_purchase_root" action="action_logistic_providers" sequence="20"/>

</odoo>
