<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- form view-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.takeaway</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="after">
                <block title="Other Features" id="other_features">
                    <group>
                        <group>
                            <setting title="POS TakeAway" string="Pos TakeAway">
                                <field name="is_takeaway" required="pos_config_id"/>
                            </setting>
                            <setting title="POS Delivery" string="Pos Delivery">
                                <field name="is_delivery" required="pos_config_id"/>
                            </setting>
                            <setting title="POS Order Phone" string="Pos Order Phone">
                                <field name="is_order_phone" required="pos_config_id"/>
                            </setting>
                            <setting title="POS Order Talabat" string="Pos Order Talabat">
                                <field name="is_talabat" required="pos_config_id"/>
                            </setting>
                            <setting title="POS Cashbox " string="Pos Cashbox">
                                <field name="allow_open_cash_d"/>
                            </setting>
                        </group>
                        <group>
                            <setting title="Generate Token" string="Generate Token">
                                <field name="is_generate_token" invisible="1"/>
                            </setting>
                        </group>
                    </group>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
