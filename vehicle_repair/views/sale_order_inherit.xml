<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="view_product_tag_tree_inherited" model="ir.ui.view">
            <field name="name">product.tag.tree.inherited</field>
            <field name="model">product.tag</field>
            <field name="inherit_id" ref="product.product_tag_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                 <field name="sequence" widget="handle"/>
                </xpath>
            </field>
        </record>

    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="chevy_number_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_helpdesk" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.helpdesk</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='order_lines']" position="before">
                <page name="helpdesk_orders" string="Technician Orders">
                    <field name="helpdesk_order_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>

                            <button string="Add " name="button_add_product"
                                    type="object"
                                    class="oe_highlight"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='helpdesk_orders']" position="attributes">
                <attribute name="invisible">state == "sale"</attribute>
            </xpath>
        </field>
    </record>


    <record id="view_crm_lead_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.product</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/group[1]/group[@name='opportunity_partner']/field[@name='partner_id']"
                   position="before">
                <field name="product_id"/>
                <field name="is_orderd"/>
            </xpath>
        </field>
    </record>



    <!-- Kanban View -->


   <record id="test_model_view_kanban" model="ir.ui.view">
        <field name="name">test.model.view.kanban</field>
        <field name="model">technician.member</field>
        <field name="arch" type="xml">
          <kanban string="Technician Member">
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click my_kanban_card">
                            <div class="o_kanban_card_header">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_card_body">
                                <div class="o_kanban_item">
                                    <i class="fa fa-envelope"/> <span><field name="email" widget="email"/></span>
                                </div>
<!--                                <div class="o_kanban_item">-->
<!--                                    <i class="fa fa-user"/> <span><field name="user_id" options="{'no_open': True}"/></span>-->
<!--                                </div>-->
                            </div>
                            <div class="o_kanban_card_footer">
                                <button class="btn btn-info" name="action_view_ticket_car_user" type="object">
                                    <i class="fa fa-ticket"/> Tickets
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban></field></record>

    <record id="view_technician_member_form" model="ir.ui.view">
        <field name="name">technician.member.form</field>
        <field name="model">technician.member</field>
        <field name="arch" type="xml">
            <form string="Technician Member">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="show_timesheet_button" />
                    </group>

                </sheet>
            </form>
        </field>
    </record>




    <!-- Menu Item -->
    <menuitem id="helpdesk_member_menu" sequence="1" name="Technician Users" parent="menu_car_techninc_menu"
              action="technician_user_model_action"/>






</odoo>
