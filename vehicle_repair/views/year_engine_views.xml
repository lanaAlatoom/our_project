<odoo>
    <record id="view_year_manufacture_form" model="ir.ui.view">
        <field name="name">year.manufacture.form</field>
        <field name="model">year.manufacture</field>
        <field name="arch" type="xml">
            <form string="Year of Manufacture">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_year_manufacture_tree" model="ir.ui.view">
        <field name="name">year.manufacture.tree</field>
        <field name="model">year.manufacture</field>
        <field name="arch" type="xml">
            <tree string="Year of Manufacture">
                <field name="name"/>
            </tree>
        </field>
    </record>


