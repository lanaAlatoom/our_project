<odoo>
     <data noupdate="1">
        <record id="seq_product_category" model="ir.sequence">
            <field name="name">Product Category Sequence</field>
            <field name="code">product.category.sequence</field>
            <field name="prefix">CAT-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>



       <record id="report_technician_car_contract" model="ir.actions.report">
            <field name="name">Print Technician Car Report</field>
            <field name="model">technician.car</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">vehicle_repair.report_technician_car</field>
            <field name="report_file">vehicle_repair.report_technician_car</field>
            <field name="binding_model_id" ref="model_technician_car"/>
            <field name="binding_type">report</field>
        </record>

     </data>
</odoo>
